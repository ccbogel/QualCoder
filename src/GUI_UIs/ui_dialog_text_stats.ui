       <string>Similarity graph</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_sim">
       <item>
        <layout class="QHBoxLayout" name="horizontalLayout_sim_params">
         <item>
          <widget class="QLabel" name="label_sim_method">
           <property name="toolTip">
            <string>Association measure between forms co-occurring in the same segment: Jaccard index (default) or chi-square (phi-squared)</string>
           </property>
           <property name="text">
            <string>Association measure:</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QComboBox" name="comboBox_sim_method">
           <property name="maximumSize">
            <size>
             <width>220</width>
             <height>16777215</height>
            </size>
           </property>
           <property name="toolTip">
            <string>Association measure between forms co-occurring in the same segment: Jaccard index (default) or chi-square (phi-squared)</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="label_sim_min_freq">
           <property name="toolTip">
            <string>Only forms occurring at least this many times appear as nodes</string>
           </property>
           <property name="text">
            <string>Minimum frequency:</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QSpinBox" name="spinBox_sim_min_freq">
           <property name="toolTip">
            <string>Only forms occurring at least this many times appear as nodes</string>
           </property>
           <property name="minimum">
            <number>1</number>
           </property>
           <property name="maximum">
            <number>9999</number>
           </property>
           <property name="value">
            <number>1</number>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="label_sim_threshold">
           <property name="toolTip">
            <string>Minimum association value for an edge to be drawn between two forms</string>
           </property>
           <property name="text">
            <string>Edge threshold:</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QDoubleSpinBox" name="doubleSpinBox_sim_threshold">
           <property name="toolTip">
            <string>Minimum association value for an edge to be drawn between two forms</string>
           </property>
           <property name="decimals">
            <number>3</number>
           </property>
           <property name="maximum">
            <double>1.000000000000000</double>
           </property>
           <property name="singleStep">
            <double>0.050000000000000</double>
           </property>
           <property name="value">
            <double>0.200000000000000</double>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QCheckBox" name="checkBox_sim_communities">
           <property name="toolTip">
            <string>Detect communities of strongly associated forms with the Louvain algorithm; each community gets its own colour in the graph</string>
           </property>
           <property name="text">
            <string>Detect communities (Louvain)</string>
           </property>
           <property name="checked">
            <bool>true</bool>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="label_sim_halo">
           <property name="toolTip">
            <string>Draw a red halo around the direct neighbours of this form in the graph</string>
           </property>
           <property name="text">
            <string>Halo:</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QComboBox" name="comboBox_sim_halo">
           <property name="maximumSize">
            <size>
             <width>180</width>
             <height>16777215</height>
            </size>
           </property>
           <property name="toolTip">
            <string>Draw a red halo around the direct neighbours of this form in the graph</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pushButton_sim_run">
           <property name="minimumSize">
            <size>
             <width>32</width>
             <height>32</height>
            </size>
           </property>
           <property name="maximumSize">
            <size>
             <width>32</width>
             <height>32</height>
            </size>
           </property>
           <property name="toolTip">
            <string>Build the similarity graph with the current parameters</string>
           </property>
           <property name="text">
            <string>Calculate</string>
           </property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="pushButton_sim_png">
           <property name="minimumSize">
            <size>
             <width>32</width>
             <height>32</height>
            </size>
           </property>
           <property name="maximumSize">
            <size>
             <width>32</width>
             <height>32</height>
            </size>
           </property>
           <property name="toolTip">
            <string>Export the similarity graph as a PNG image</string>
           </property>
           <property name="text">
            <string>Export PNG</string>
           </property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <widget class="QLabel" name="label_sim_help">
         <property name="toolTip">
          <string>Similarity graph: each node is a form (size = frequency), each edge links two forms co-occurring in the same segment (width = association strength), node colours = detected communities. Below: the strongest edges and the communities.</string>
         </property>
         <property name="text">
          <string>Similarity graph: each node is a form (size = frequency), each edge links two forms co-occurring in the same segment (width = association strength), node colours = detected communities. Below: the strongest edges and the communities.</string>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="label_sim_info">
         <property name="toolTip">
          <string>Summary of the last graph: nodes, edges, communities</string>
         </property>
         <property name="text">
          <string/>
         </property>
         <property name="wordWrap">
          <bool>true</bool>
         </property>
        </widget>
       </item>
       <item>
        <widget class="QTextBrowser" name="textBrowser_sim">
         <property name="toolTip">
          <string>Strongest edges of the graph (form - form: association value) and detected communities</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:338
msgid "Two concepts co-occur or are linked but without a specified causal or hierarchical direction."
msgstr "Dos conceptos co-ocurren o están vinculados, pero sin una dirección causal o jerárquica especificada."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:339
msgid "One concept produces, generates, or leads to another."
msgstr "Un concepto produce, genera o conduce a otro."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:340
msgid "One concept is a component, dimension, or facet of another."
msgstr "Un concepto es un componente, una dimensión o una faceta de otro."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:341
msgid "Subsumption: one concept is a type or instance of another."
msgstr "Subsunción: un concepto es un tipo o una instancia de otro."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:342
msgid "One concept describes an attribute or quality of another."
msgstr "Un concepto describe un atributo o una cualidad de otro."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:343
msgid "Two concepts are in tension, opposition, or mutual exclusion."
msgstr "Dos conceptos se encuentran en tensión, oposición o exclusión mutua."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:344
msgid "One concept provides evidence, confirmation, or reinforcement for another."
msgstr "Un concepto aporta evidencia, confirmación o refuerzo a otro."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:345
msgid "One concept provides the situational backdrop for another."
msgstr "Un concepto proporciona el trasfondo situacional de otro."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:346
msgid "One concept occurs before another in time or sequence."
msgstr "Un concepto ocurre antes que otro en el tiempo o en la secuencia."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:347
msgid "One concept provides the rationale or legitimation for another."
msgstr "Un concepto aporta la justificación o la legitimación de otro."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:348
msgid "A causal, intervening, or contextual condition that influences the phenomenon."
msgstr "Una condición causal, interviniente o contextual que influye en el fenómeno."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:349
msgid "An action/interaction strategy used in response to or to manage the phenomenon."
msgstr "Una estrategia de acción o interacción empleada en respuesta al fenómeno o para gestionarlo."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:350
msgid "A result or outcome that follows from action/interaction strategies."
msgstr "Un resultado o efecto que se deriva de las estrategias de acción e interacción."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:351
msgid "The set of conditions within which strategies are enacted."
msgstr "El conjunto de condiciones en las que se despliegan las estrategias."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:352
msgid "A broader structural condition that facilitates or constrains strategies."
msgstr "Una condición estructural más amplia que facilita o restringe las estrategias."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:353
msgid "The core category or central idea to which all other categories relate."
msgstr "La categoría central o idea nuclear con la que se relacionan todas las demás categorías."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:354
msgid "A property varies along this continuum or range."
msgstr "Una propiedad varía a lo largo de este continuo o rango."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:355
msgid "One category is subsumed under or elaborates a higher-order category."
msgstr "Una categoría se subsume en una categoría de orden superior o la desarrolla."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:356
msgid "Two concepts co-occur without specified directionality."
msgstr "Dos conceptos co-ocurren sin direccionalidad especificada."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:357
msgid "A processual or temporal link between phases."
msgstr "Un vínculo procesual o temporal entre fases."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:358
msgid "A superordinate category that organizes subcategories."
msgstr "Una categoría supraordinada que organiza subcategorías."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:359
msgid "A subordinate category under a main category."
msgstr "Una categoría subordinada dentro de una categoría principal."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:360
msgid "A prototypical text passage that defines a category."
msgstr "Un pasaje de texto prototípico que define una categoría."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:361
msgid "A decision rule that resolves ambiguity between categories."
msgstr "Una regla de decisión que resuelve la ambigüedad entre categorías."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:362
msgid "Two categories share some coded segments or meaning."
msgstr "Dos categorías comparten segmentos codificados o significados."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:363
msgid "One category is a more precise version of another after revision."
msgstr "Una categoría es una versión más precisa de otra tras la revisión."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:364
msgid "Two categories or findings are in tension."
msgstr "Dos categorías o hallazgos se encuentran en tensión."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:365
msgid "One category captures the gist of several lower-level categories."
msgstr "Una categoría recoge lo esencial de varias categorías de nivel inferior."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:366
msgid "One category clarifies the meaning of another through context."
msgstr "Una categoría aclara el significado de otra a través del contexto."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:367
msgid "One category provides the organizing frame for others."
msgstr "Una categoría proporciona el marco organizador de las demás."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:368
msgid "Describes WHAT was experienced (the noema)."
msgstr "Describe QUÉ se experimentó (el noema)."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:369
msgid "Describes HOW the experience was lived (the noesis)."
msgstr "Describe CÓMO se vivió la experiencia (la noesis)."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:370
msgid "The invariant meaning that persists across individual experiences."
msgstr "El significado invariante que persiste a través de las experiencias individuales."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:371
msgid "A meaning unit that bounds or delimits the experience."
msgstr "Una unidad de significado que acota o delimita la experiencia."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:372
msgid "An experiential structure that recurs across participants."
msgstr "Una estructura experiencial que se repite entre los participantes."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:373
msgid "The experience manifests through bodily sensation or corporeal presence."
msgstr "La experiencia se manifiesta a través de la sensación corporal o la presencia del cuerpo."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:374
msgid "The experience occurs within a specific spatial context."
msgstr "La experiencia ocurre dentro de un contexto espacial específico."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:375
msgid "The experience unfolds within subjective time."
msgstr "La experiencia se despliega en el tiempo subjetivo."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:376
msgid "The experience involves connection with others."
msgstr "La experiencia implica la conexión con otros."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:377
msgid "One meaning unit participates in constructing a broader theme."
msgstr "Una unidad de significado participa en la construcción de un tema más amplio."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:378
msgid "A data-driven or theory-driven label assigned to a data segment."
msgstr "Una etiqueta inductiva o deductiva asignada a un segmento de datos."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:379
msgid "A provisional theme that groups related codes."
msgstr "Un tema provisional que agrupa códigos relacionados."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:380
msgid "A theme nested within a broader overarching theme."
msgstr "Un tema anidado dentro de un tema general más amplio."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:381
msgid "Two themes share codes or meaning territory."
msgstr "Dos temas comparten códigos o territorio de significado."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:382
msgid "A revised version of a theme after review."
msgstr "Una versión revisada de un tema tras su revisión."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:383
msgid "The 'essence' or core meaning of a theme."
msgstr "La \"esencia\" o significado nuclear de un tema."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:384
msgid "A vivid data extract that captures the theme."
msgstr "Un extracto de datos vívido que capta el tema."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:385
msgid "One theme provides the situational backdrop for another."
msgstr "Un tema proporciona el trasfondo situacional de otro."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:386
msgid "Two themes or codes are in tension."
msgstr "Dos temas o códigos se encuentran en tensión."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:387
msgid "Co-occurrence or conceptual affinity."
msgstr "Co-ocurrencia o afinidad conceptual."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:388
msgid "A discursive practice that produces a social object or subject position."
msgstr "Una práctica discursiva que produce un objeto social o una posición de sujeto."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:389
msgid "One discourse provides justification or authority to another."
msgstr "Un discurso aporta justificación o autoridad a otro."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:390
msgid "A counter-discourse that challenges or subverts a dominant discourse."
msgstr "Un contradiscurso que cuestiona o subvierte un discurso dominante."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:391
msgid "A discourse that makes a social construction appear self-evident."

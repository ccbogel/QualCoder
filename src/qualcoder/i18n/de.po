msgid "Analytically productive tensions."
msgstr "Analytisch produktive Spannungen."

#: src/qualcoder/view_graph_relations.py:428
msgid "Summarizing content analysis."
msgstr "Zusammenfassende Inhaltsanalyse."

#: src/qualcoder/view_graph_relations.py:429
msgid "Explicating content analysis."
msgstr "Explizierende Inhaltsanalyse."

#: src/qualcoder/view_graph_relations.py:430
msgid "Structuring content analysis."
msgstr "Strukturierende Inhaltsanalyse."

#: src/qualcoder/view_graph_relations.py:431
msgid "Moustakas: textural = content of experience."
msgstr "Moustakas: textural = Inhalt der Erfahrung."

#: src/qualcoder/view_graph_relations.py:432
msgid "Moustakas: structural = conditions/context."
msgstr "Moustakas: struktural = Bedingungen/Kontext."

#: src/qualcoder/view_graph_relations.py:433

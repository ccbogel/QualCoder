msgstr "Macht-Wissen-Komplex."

#: src/qualcoder/view_graph_relations.py:453
msgid "Counter-hegemonic practice."
msgstr "Gegenhegemoniale Praxis."

#: src/qualcoder/view_graph_relations.py:454
msgid "Ideological function."
msgstr "Ideologische Funktion."

#: src/qualcoder/view_graph_relations.py:455
msgid "Intertextuality (Fairclough)."
msgstr "Intertextualität (Fairclough)."

#: src/qualcoder/view_graph_relations.py:456
msgid "Subject positioning."
msgstr "Subjektpositionierung."

#: src/qualcoder/view_graph_relations.py:457
msgid "Field, tenor, mode (Halliday)."
msgstr "Feld, Tenor, Modus (Halliday)."

#: src/qualcoder/view_graph_relations.py:458
msgid "Epistemic and deontic modality."
msgstr "Epistemische und deontische Modalität."

#: src/qualcoder/view_graph_relations.py:459
msgid "Pragmatic presupposition."
msgstr "Pragmatische Präsupposition."

#: src/qualcoder/view_graph_relations.py:460
msgid "Conceptual metaphor (Lakoff & Johnson)."
msgstr "Konzeptuelle Metapher (Lakoff & Johnson)."


msgstr "Kombinierte textural-strukturale Beschreibung."

#: src/qualcoder/view_graph_relations.py:434
msgid "Horizonalization: each statement has equal value."
msgstr "Horizontialisierung: Jede Aussage ist gleichwertig."

#: src/qualcoder/view_graph_relations.py:435
msgid "van Manen: existential themes."
msgstr "van Manen: existenzielle Themen."

#: src/qualcoder/view_graph_relations.py:436
msgid "Lived body (corporeality)."
msgstr "Gelebter Körper (Körperlichkeit)."

#: src/qualcoder/view_graph_relations.py:437
msgid "Lived space (spatiality)."
msgstr "Gelebter Raum (Räumlichkeit)."

#: src/qualcoder/view_graph_relations.py:438
msgid "Lived time (temporality)."
msgstr "Gelebte Zeit (Zeitlichkeit)."

#: src/qualcoder/view_graph_relations.py:439
msgid "Lived relation (relationality)."
msgstr "Gelebte Beziehung (Relationalität)."

#: src/qualcoder/view_graph_relations.py:440
msgid "Phenomenological constitution."
msgstr "Phänomenologische Konstitution."

#: src/qualcoder/view_graph_relations.py:441
msgid "Phase 2: generating initial codes."
msgstr "Phase 2: Erste Codes erstellen."

#: src/qualcoder/view_graph_relations.py:442
msgid "Phase 3: searching for themes."
msgstr "Phase 3: Nach Themen suchen."

#: src/qualcoder/view_graph_relations.py:443
msgid "Hierarchical thematic structure."
msgstr "Hierarchische Themenstruktur."


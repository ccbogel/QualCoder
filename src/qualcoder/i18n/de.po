msgid "Framework:"
msgstr "Framework:"

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:482
msgid "Search relations..."
msgstr "Beziehungen durchsuchen..."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:483
msgid "Custom label:"
msgstr "Benutzerdefinierte Bezeichnung:"

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:484
msgid "Override with a custom label..."
msgstr "Durch benutzerdefinierte Bezeichnung ersetzen..."

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:485
msgid "Color:"
msgstr "Farbe:"

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:486
msgid "Line type:"
msgstr "Linientyp:"

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:488
msgid "Edit"
msgstr "Bearbeiten"

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:490
#: /home/qwerty/Bureau/QualCoder/src/qualcoder/manage_references_import.py:158
msgid "Import"
msgstr "Importieren"

#: /home/qwerty/Bureau/QualCoder/src/qualcoder/view_graph_relations.py:492
